# Copy these into the backend deployment environment; never commit real credentials.
# Existing node creation is disabled until NODE_API_TOKEN and NODE_IP are configured.
NODE_API_TOKEN=replace-with-a-long-random-server-secret
NODE_IP=
XRAY_API_PORT=10085
CORS_ORIGINS=https://shuji-chu.github.io
USER_API_BASE=https://web.lynli.me/api/v1

# S3-compatible object storage (Alibaba OSS S3 endpoint or Cloudflare R2).
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
S3_REGION=your-region
S3_BUCKET=your-private-bucket-name
S3_ACCESS_KEY_ID=server-side-access-key-id
S3_SECRET_ACCESS_KEY=server-side-access-key-secret
MEDIA_PUBLIC_BASE_URL=https://img.example.com
HOME_BANNERS_OBJECT_KEY=site-config/home-banners.json
TELEGRAM_BOTS_OBJECT_KEY=site-config/telegram-bots.json
ACCOUNT_CARD_OVERRIDES_OBJECT_KEY=site-config/account-card-overrides.json

# Must be a real endpoint that validates the supplied Bearer token and admin role.
# Keep redirects disabled on the identity endpoint; do not point this at a public health check.
ADMIN_AUTH_VERIFY_URL=https://your-auth-api.example/api/v1/admin/dashboard
